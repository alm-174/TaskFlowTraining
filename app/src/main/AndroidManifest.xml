<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TaskFlowApp"
        android:allowBackup="true"
        android:label="TaskFlow"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskFlowTraining">

        <!-- Màn hình chính: TaskFlow -->
        <activity
            android:name=".TaskActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Màn hình Coroutine ngày 09 -->
        <activity
            android:name=".CoroutineDemoActivity"
            android:exported="false" />

        <!-- Các Activity đã học -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DetailActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".StateActivity"
            android:exported="false" />

        <activity
            android:name=".RemoteTodoActivity"
            android:exported="true" />

    </application>

</manifest>
